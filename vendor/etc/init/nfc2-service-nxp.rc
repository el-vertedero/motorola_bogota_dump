on property:ro.vendor.hw.nfc=ese_nq && property:persist.vendor.nfc.config_file_name=*
    start vendor.nfc_hal_service

on property:ro.vendor.hw.nfc=nq && property:persist.vendor.nfc.config_file_name=*
    start vendor.nfc_hal_service

service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc2-service.nxp
    interface aidl android.hardware.nfc.INfc/default
    interface aidl vendor.nxp.nxpnfc_aidl.INxpNfc/default
    class early_hal
    user nfc
    group nfc drmrpc system
    oneshot
    disabled
